{
  "name": "l-lex",
  "private": true,
  "version": "0.1.0",
  "description": "L-LEX — trilingual (Kurdish Sorani / Arabic / English) search engine for Iraqi and Kurdistan Region legislation. Static, fast, no login.",
  "keywords": [
    "kurdish",
    "arabic",
    "iraqi-law",
    "legal-search",
    "kurdistan"
  ],
  "author": "Las Khoshnaw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrGuevar4/L-LEX.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:normalize": "node scripts/normalize-source.ts",
    "data:classify": "node scripts/classify-penalties.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.2.8"
  }
}
